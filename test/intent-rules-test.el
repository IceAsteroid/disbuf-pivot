(describe "disbuf-pivot header info formatting and source labels"
  (it "formats category, window-setting effect phrases in order, fallback chains, and source-labeled entries"
    (let* ((dp-action--action
            '((display-buffer-in-direction display-buffer-in-child-frame my-custom-fn)
              (category . compile)
              (direction . right)
              (window-width . (body-columns . 80))
              (dedicated . t)
              (preserve-size . (t . nil))
              (window-height . 20)
              (window-parameters . ((no-delete-other-windows . t)))
              (window-size . (body-chars . (80 . 24)))))
           (display-buffer-base-action
            '(nil (window-height . 10) (inhibit-same-window . t)))
           (display-buffer-overriding-action
            '(nil (dedicated . nil)))
           (combined-alist
            '((direction . right)
              (dedicated . t)
              (window-parameters . ((no-delete-other-windows . t)))
              (preserve-size . (t . nil))
              (window-height . 20)
              (window-width . (body-columns . 80))
              (window-size . (body-chars . (80 . 24)))
              (inhibit-same-window . t)))
           (header (dp-action--build-header-info
                    "direction right"
                    '(display-buffer-in-direction
                      display-buffer-in-child-frame
                      my-custom-fn)
                    combined-alist
                    '("selected window cannot display")
                    t)))
      ;; Category tag, Section 9 fixed order, English a/an, and `; else ` fallbacks
      (expect (plist-get header :caller-intent)
              :to-equal
              (concat "Caller (compile): direction right, dedicated, "
                      "window parameters, preserve width, a 20-line window, "
                      "an 80-column body, a new frame with an 80 by 24 body; "
                      "else child frame; else my-custom-fn"))
      ;; Non-caller entry attributed accurately (overriding `(dedicated . nil)` does NOT steal caller `(dedicated . t)`)
      (expect (plist-get header :source-entries)
              :to-equal '("base action: inhibit same window"))
      (expect (plist-get header :window-facts)
              :to-equal '("selected window cannot display"))
      ;; Additional effect phrase variants
      (expect (dp-action--window-setting-effect 'preserve-size '(nil . t))
              :to-equal "preserve height")
      (expect (dp-action--window-setting-effect 'preserve-size '(t . t))
              :to-equal "preserve size")
      (expect (dp-action--window-setting-effect 'preserve-size '(nil . nil))
              :to-be nil)
      (expect (dp-action--window-setting-effect 'window-height 0.25)
              :to-equal "25% of the frame high")
      (expect (dp-action--window-setting-effect 'window-height '(body-lines . 8))
              :to-equal "a window with an 8-line body")
      (expect (dp-action--window-setting-effect 'window-height 'fit-window-to-buffer)
              :to-equal "fit-window-to-buffer")
      (expect (dp-action--window-setting-effect 'window-width 0.5)
              :to-equal "50% of the frame wide")
      (expect (dp-action--window-setting-effect 'window-width 40)
              :to-equal "a 40-column window")
      (expect (dp-action--window-setting-effect 'window-size '(100 . 40))
              :to-equal "a new frame 100 columns by 40 lines"))))

(describe "disbuf-pivot Section 10 failure-after-choice recovery"
  (it "re-prompts when a chosen window dies, a chosen frame dies, or a chosen tab vanishes"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-fail*"))
           (other (get-buffer-create "*m3-fail-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (unwind-protect
          (progn
            ;; 1. Dead chosen window re-prompts dispatch prompt with feedback
            (let* ((w-dead (split-window w2 nil 'right))
                   (prompt-calls 0)
                   (seen-fb nil))
              (delete-window w-dead)
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq prompt-calls (1+ prompt-calls))
                           (if (= prompt-calls 1)
                               (list :action 'window :window w-dead :alist a)
                             (setq seen-fb (plist-get opts :initial-feedback))
                             (list :action 'window :window w2 :alist a)))))
                (expect (dp-action--prompt-and-display buf nil) :to-be w2)
                (expect prompt-calls :to-be 2)
                (expect seen-fb :to-match "no longer live")))

            ;; 2. Dead chosen frame re-prompts frame prompt
            (let* ((f-dead 'fake-dead-frame)
                   (f-alive t)
                   (reads 0)
                   (orig-framep (symbol-function 'framep))
                   (orig-live (symbol-function 'frame-live-p))
                   (orig-fp (symbol-function 'frame-parameter)))
              (cl-letf (((symbol-function 'framep)
                         (lambda (f)
                           (if (eq f f-dead) t (funcall orig-framep f))))
                        ((symbol-function 'frame-live-p)
                         (lambda (f)
                           (if (eq f f-dead) f-alive (funcall orig-live f))))
                        ((symbol-function 'frame-parameter)
                         (lambda (f p)
                           (if (eq f f-dead)
                               (and (eq p 'name) "DeadFrame")
                             (funcall orig-fp f p))))
                        ((symbol-function 'dp-action--frames)
                         (lambda (&rest _)
                           (if (= reads 0) (list f-dead (selected-frame))
                             (list (selected-frame)))))
                        ((symbol-function 'completing-read)
                         (lambda (&rest _)
                           (setq reads (1+ reads))
                           (if (= reads 1)
                               (progn
                                 (setq f-alive nil)
                                 "DeadFrame")
                             (or (frame-parameter (selected-frame) 'name) "frame"))))
                        ((symbol-function 'select-frame-set-input-focus) #'ignore)
                        ((symbol-function 'tab-bar-tabs)
                         (lambda () '(((name . "one")))))
                        ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'window :window w2 :alist a))))
                (expect (dp-action--frame buf nil) :to-be w2)
                (expect reads :to-be 2)))

            ;; 3. Vanished chosen existing tab re-prompts tab prompt
            (let ((tabs '(((name . "one") (index . 0))
                          ((name . "vanish") (index . 1))))
                  (reads 0))
              (cl-letf (((symbol-function 'tab-bar-tabs) (lambda () tabs))
                        ((symbol-function 'tab-bar-select-tab) #'ignore)
                        ((symbol-function 'completing-read)
                         (lambda (&rest _)
                           (setq reads (1+ reads))
                           (if (= reads 1)
                               (progn
                                 (setq tabs '(((name . "one") (index . 0))))
                                 "vanish")
                             "one")))
                        ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'window :window w2 :alist a))))
                (expect (car-safe (dp-action-tab buf nil)) :to-be w2)
                (expect reads :to-be 2))))
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "reports and returns fail when a display primitive returns nil, and propagates errors"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-err*"))
           (other (get-buffer-create "*m3-err-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. window--display-buffer returning nil -> message + fail (no fallback!)
            (let ((msgs nil)
                  (later-ran nil))
              (cl-letf (((symbol-function 'message)
                         (lambda (fmt &rest args) (push (apply #'format fmt args) msgs)))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'window :window w2 :alist a)))
                        ((symbol-function 'window--display-buffer)
                         (lambda (&rest _) nil))
                        ((symbol-function 'display-buffer-pop-up-window)
                         (lambda (&rest _) (setq later-ran t) w2)))
                (expect (display-buffer buf '((display-buffer-pop-up-window)))
                        :to-be nil)
                (expect later-ran :to-be nil)
                (expect (cl-some (lambda (m) (string-match-p "returned nil" m)) msgs)
                        :to-be-truthy)))
            ;; 2. display-buffer-pop-up-frame returning nil -> message + fail
            (let ((msgs nil))
              (cl-letf (((symbol-function 'message)
                         (lambda (fmt &rest args) (push (apply #'format fmt args) msgs)))
                        ((symbol-function 'dp-action--frames) (lambda (&rest _) nil))
                        ((symbol-function 'completing-read) (lambda (&rest _) ""))
                        ((symbol-function 'display-buffer-pop-up-frame)
                         (lambda (&rest _) nil)))
                (expect (dp-action--frame buf nil) :to-be 'fail)
                (expect (cl-some (lambda (m) (string-match-p "returned nil" m)) msgs)
                        :to-be-truthy)))
            ;; 3. Error from body-function propagates
            (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                       (lambda (_b a &rest _)
                         (list :action 'window :window w2 :alist a))))
              (expect (display-buffer
                       buf (list '(display-buffer-pop-up-window)
                                 (cons 'body-function
                                       (lambda (_w) (error "body-boom")))))
                      :to-throw 'error)))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "applies disbuf-pivot-action-select on M-c, forwards conflict feedback, handles standalone no-window, and attributes source inhibit-same-window"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-audit*"))
           (other (get-buffer-create "*m3-audit-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. dp-action-select = t selects window returned by M-c caller-intent
            (let ((dp-action-select t))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'caller-intent :alist a)))
                        ((symbol-function 'display-buffer-below-selected)
                         (lambda (b _a) (set-window-buffer w2 b) w2)))
                (select-window w1)
                (expect (display-buffer buf '((display-buffer-below-selected)))
                        :to-be w2)
                (expect (selected-window) :to-be w2)))
            ;;    dp-action-select = nil restores previous window after pop-to-buffer + M-c
            (select-window w1)
            (let ((dp-action-select nil)
                  (post-command-hook nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'caller-intent :alist a)))
                        ((symbol-function 'display-buffer-below-selected)
                         (lambda (b _a) (set-window-buffer w2 b) w2)))
                (pop-to-buffer buf '((display-buffer-below-selected)))
                (expect (selected-window) :to-be w2)
                (run-hooks 'post-command-hook)
                (expect (selected-window) :to-be w1)))

            ;; 2. Same-window conflict passes :initial-feedback to dispatch prompt
            (select-window w1)
            (set-window-buffer w1 other)
            (let ((display-buffer-base-action '(nil (inhibit-same-window . t)))
                  (dp-same-window-conflict 'ask)
                  (seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf '((display-buffer-same-window)))
                        :to-be w1)
                (expect (plist-get seen-opts :initial-feedback)
                        :to-match "same-window conflict.*base action")))

            ;; 3. Standalone display-buffer-no-window (no allow-no-window) strips dead fn:
            ;;    - with dedicated selected window: no dead caller-action, preserves category
            (set-window-buffer w1 other)
            (set-window-buffer w2 other)
            (set-window-dedicated-p w1 t)
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf '((display-buffer-no-window)
                                              (category . quiet)))
                        :to-be w2)
                (expect (plist-get seen-opts :caller-action) :to-be nil)
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller (quiet): no preference")))
            (set-window-dedicated-p w1 nil)
            ;;    - with inhibit-same-window: M-c runs other-window fallback-fns
            (set-window-buffer w1 other)
            (set-window-buffer w2 other)
            (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                       (lambda (_b a &rest _)
                         (list :action 'caller-intent :alist a)))
                      ((symbol-function 'display-buffer-pop-up-window)
                       (lambda (b _a) (set-window-buffer w2 b) w2)))
              (expect (display-buffer buf '((display-buffer-no-window)
                                            (inhibit-same-window . t)))
                      :to-be w2))

            ;; 4. Non-caller inhibit-same-window shown in :source-entries for
            ;;    reuse miss, full-frame, and use-some-window
            (set-window-buffer w1 buf)
            (set-window-buffer w2 other)
            (let ((display-buffer-base-action '(nil (inhibit-same-window . t))))
              (dolist (act '(((display-buffer-reuse-window))
                             ((display-buffer-full-frame))
                             ((display-buffer-use-some-window))))
                (let ((seen-header nil))
                  (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                             (lambda (_b a &rest opts)
                               (setq seen-header (plist-get opts :header-info))
                               (list :action 'window :window w2 :alist a))))
                    (expect (display-buffer buf act) :to-be w2)
                    (expect (plist-get seen-header :source-entries)
                            :to-equal '("base action: inhibit same window"))))))

            ;; 5. Window-fact labels ignore invalid dp-split-actions entries
            (let ((dp-split-actions '((?1 not-a-real-function "invalid"))))
              (expect (dp-action--format-window-list-fact (list w1))
                      :to-equal "window [1] displays the buffer"))

            ;; 6. dp-action--target prioritizes pop-up-frames over tab-name when no fns,
            ;;    and dp-action-tab maps frame-gone on reusable tab to fail
            (let ((dp-action--action nil))
              (expect (dp-action--target '((pop-up-frames . t) (tab-name . "t")))
                      :to-be 'frame))
            (cl-letf (((symbol-function 'tab-bar-get-buffer-tab)
                       (lambda (&rest _) (list (cons 'frame (selected-frame))
                                               (cons 'index 0))))
                      ((symbol-function 'select-frame-set-input-focus) #'ignore)
                      ((symbol-function 'tab-bar-select-tab) #'ignore)
                      ((symbol-function 'dp-action--display-in-tab)
                       (lambda (&rest _) '(frame-gone . nil))))
              (expect (dp-action-tab buf '((reusable-frames . t)))
                      :to-equal '(fail . fail))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "covers mode-reuse indirect swap, extra-action precedence, target rules, tab/frame edge cases, and caller vs source attribution"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-fix2*"))
           (other (get-buffer-create "*m3-fix2-other*"))
           (base (get-buffer-create "*m3-fix2-base*"))
           (ind (make-indirect-buffer base "*m3-fix2-ind*")))
      (with-current-buffer base (dp-test-base-mode))
      (with-current-buffer ind (dp-test-base-mode))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. display-buffer-reuse-mode-window must NOT trigger (reuse-indirect . buffer) no-swap
            (set-window-buffer w2 base)
            (let ((dp-reuse 'auto))
              (expect (display-buffer ind '((display-buffer-reuse-mode-window)
                                            (reuse-indirect . buffer)))
                      :to-be w2)
              (expect (window-buffer w2) :to-be ind))

            ;; 2. extra-action precedes display-buffer-base-action for (display-buffer buf t)
            (set-window-buffer w2 other)
            (let ((display-buffer-base-action '(nil (inhibit-same-window . t)))
                  (seen-header nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-header (plist-get opts :header-info))
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf t) :to-be w2)
                (expect (plist-get seen-header :source-entries)
                        :to-equal '("extra action: inhibit same window"))))

            ;; 3. dp-action--target mirrors dp-action--dispatch-by-functions
            (let ((dp-action--action '((display-buffer-pop-up-window))))
              (expect (dp-action--target '((pop-up-frames . t))) :to-be nil))
            (let ((dp-action--action '((display-buffer-pop-up-frame
                                        display-buffer-in-side-window))))
              (expect (dp-action--target nil) :to-be 'frame))
            (let ((dp-action--action '((dp-test--uncovered-fn))))
              (expect (dp-action--target '((tab-name . "x"))) :to-be nil))
            (let ((dp-action--action '((display-buffer-no-window))))
              (expect (dp-action--target '((pop-up-frames . t))) :to-be 'frame)
              (expect (dp-action--target '((allow-no-window . t) (pop-up-frames . t)))
                      :to-be nil))

            ;; 4. Split inside a newly made tab preserves TYPE `window'
            (cl-letf (((symbol-function 'tab-bar-tabs)
                       (lambda () '(((name . "one") (index . 0)))))
                      ((symbol-function 'tab-bar-new-tab) #'ignore)
                      ((symbol-function 'tab-bar-rename-tab) #'ignore)
                      ((symbol-function 'tab-bar-change-tab-group) #'ignore)
                      ((symbol-function 'completing-read) (lambda (&rest _) "brand-new"))
                      ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                      ((symbol-function 'dp-window-utility-dispatch-prompt)
                       (lambda (_b a &rest _) (list :action 'split :window w2 :alist a))))
              (expect (cdr-safe (dp-action-tab buf nil)) :to-be 'window))

            ;; 5. Vanished existing tab inside dp-action--frame re-prompts tab prompt
            (let ((tabs '(((name . "one") (index . 0))
                          ((name . "vanish") (index . 1))))
                  (tab-reads 0)
                  (new-tabs 0)
                  (frame-name (or (frame-parameter (selected-frame) 'name) "frame")))
              (cl-letf (((symbol-function 'dp-action--frames)
                         (lambda (&rest _) (list (selected-frame))))
                        ((symbol-function 'select-frame-set-input-focus) #'ignore)
                        ((symbol-function 'tab-bar-tabs) (lambda () tabs))
                        ((symbol-function 'tab-bar-select-tab) #'ignore)
                        ((symbol-function 'tab-bar-new-tab)
                         (lambda (&rest _) (setq new-tabs (1+ new-tabs))))
                        ((symbol-function 'tab-bar-rename-tab) #'ignore)
                        ((symbol-function 'completing-read)
                         (lambda (prompt &rest _)
                           (if (string-match-p "Frame" prompt)
                               frame-name
                             (setq tab-reads (1+ tab-reads))
                             (if (= tab-reads 1)
                                 (progn (setq tabs '(((name . "one") (index . 0))))
                                        "vanish")
                               "one"))))
                        ((symbol-function 'get-buffer-window) (lambda (&rest _) nil))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _) (list :action 'window :window w2 :alist a))))
                (expect (dp-action--frame buf nil) :to-be w2)
                (expect tab-reads :to-be 2)
                (expect new-tabs :to-be 0)))

            ;; 6. Other-window M-c falls back to display-buffer-pop-up-frame when splitting fails
            (delete-window w2)
            (set-window-buffer w1 other)
            (set-window-dedicated-p w1 t)
            (let ((split-window-preferred-function (lambda (&rest _) nil))
                  (prompt-calls 0)
                  (pop-frame-calls 0))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (setq prompt-calls (1+ prompt-calls))
                           (list :action 'caller-intent :alist a)))
                        ((symbol-function 'display-buffer-pop-up-frame)
                         (lambda (b _a)
                           (setq pop-frame-calls (1+ pop-frame-calls))
                           (set-window-dedicated-p w1 nil)
                           (set-window-buffer w1 b)
                           w1)))
                (expect (display-buffer buf t) :to-be w1)
                (expect prompt-calls :to-be 1)
                (expect pop-frame-calls :to-be 1)))
            (set-window-dedicated-p w1 nil)
            (setq w2 (split-window w1 nil 'below))

            ;; 7. Window-list-fact deduplicates repeated frame names for out-of-scope windows
            (let ((f2 'fake-work-frame)
                  (orig-wf (symbol-function 'window-frame))
                  (orig-fp (symbol-function 'frame-parameter)))
              (cl-letf (((symbol-function 'window-frame)
                         (lambda (&optional win)
                           (if (memq win (list w1 w2)) f2 (funcall orig-wf win))))
                        ((symbol-function 'frame-parameter)
                         (lambda (fr p)
                           (if (eq fr f2)
                               (and (eq p 'name) "Work")
                             (funcall orig-fp fr p))))
                        ((symbol-function 'dp-window-utility--scope-windows)
                         (lambda (&optional _) nil)))
                (expect (dp-action--format-window-list-fact (list w1 w2))
                        :to-equal "windows in frame Work display the buffer")))

            ;; 8. dp-action-choose-window reports reuse window facts when reuse was not run first
            (set-window-buffer w1 other)
            (set-window-buffer w2 buf)
            (select-window w1)
            (let ((dp-action-functions '(dp-action-choose-window))
                  (seen-header nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-header (plist-get opts :header-info))
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf) :to-be w1)
                (expect (car (plist-get seen-header :window-facts))
                        :to-match "\\[2\\].*displays the buffer")))

            ;; 9. Caller intent info reads caller's ACTION strictly while source-entries
            ;;    reports non-caller direction / previous-window overrides
            (set-window-buffer w1 other)
            (set-window-buffer w2 other)
            (let ((display-buffer-overriding-action '(nil (direction . right)))
                  (seen-header nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-header (plist-get opts :header-info))
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf '((display-buffer-in-direction)
                                              (direction . left)))
                        :to-be w2)
                (expect (plist-get seen-header :caller-intent)
                        :to-equal "Caller: direction left")
                (expect (plist-get seen-header :source-entries)
                        :to-equal '("overriding action: direction right")))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (set-window-dedicated-p w1 nil)
        (kill-buffer ind)
        (kill-buffer base)
        (kill-buffer buf)
        (kill-buffer other)))))

