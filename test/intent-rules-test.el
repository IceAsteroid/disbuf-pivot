;;; intent-rules-test.el --- Milestone 3 intent classifier and dispatch tests  -*- lexical-binding: t; -*-

;;; Commentary:
;; Buttercup tests covering `docs/DESIGN_RULESET.md' sections 3, 4, 9,
;; and 10: all 19 Emacs 31.1 `display-buffer-*' action functions,
;; reuse-first chains, non-list ACTION and dynamic `pop-up-frames' /
;; `display-buffer-reuse-frames', regulated `dp-action--run',
;; `window--display-buffer' TYPE propagation, `inhibit-same-window'
;; override and conflict, `display-buffer-full-frame', `reuse-indirect',
;; `mode' default and 4-tier priority, variable-symbol `previous-window',
;; cross-frame reuse default, header info and source-labeled entries,
;; and Section 10 failure-after-choice recovery.

;;; Code:

(require 'buttercup)
(require 'cl-lib)
(require 'disbuf-pivot)

(define-derived-mode dp-test-base-mode fundamental-mode "DP-Base")
(define-derived-mode dp-test-child-mode dp-test-base-mode "DP-Child")

(defvar dp-test-prev-win-var nil
  "Bound variable holding a window for `previous-window' dereference tests.")

(describe "disbuf-pivot effective-intent classifier"
  (it "respects fixed-place (side, atom, child-frame) and uncovered functions without prompting"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (prompt-calls 0)
           (custom-ran nil)
           (buf (get-buffer-create "*m3-respect*")))
      (dp-action-mode +1)
      (unwind-protect
          (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                     (lambda (&rest _)
                       (setq prompt-calls (1+ prompt-calls))
                       nil)))
            ;; 1. display-buffer-in-side-window
            (let ((side (display-buffer
                         buf '((display-buffer-in-side-window)
                               (side . right)))))
              (expect (window-parameter side 'window-side) :to-be 'right)
              (expect prompt-calls :to-be 0)
              (when (window-live-p side) (delete-window side)))
            ;; 2. display-buffer-in-atom-window
            (let ((atom-ran nil))
              (cl-letf (((symbol-function 'display-buffer-in-atom-window)
                         (lambda (b _a)
                           (setq atom-ran t)
                           (set-window-buffer w2 b)
                           w2)))
                (expect (display-buffer
                         buf '((display-buffer-in-atom-window)
                               (side . below)))
                        :to-be w2)
                (expect atom-ran :to-be t)
                (expect prompt-calls :to-be 0)))
            ;; 3. display-buffer-in-child-frame
            (let ((child-ran nil))
              (cl-letf (((symbol-function 'display-buffer-in-child-frame)
                         (lambda (b _a)
                           (setq child-ran t)
                           (set-window-buffer w2 b)
                           w2)))
                (expect (display-buffer
                         buf '((display-buffer-in-child-frame)
                               (child-frame-parameters . ((width . 40)))))
                        :to-be w2)
                (expect child-ran :to-be t)
                (expect prompt-calls :to-be 0)))
            ;; 4. Uncovered custom lambda
            (expect (display-buffer
                     buf (list (lambda (b _a)
                                 (setq custom-ran 'lambda)
                                 (set-window-buffer w2 b)
                                 w2)))
                    :to-be w2)
            (expect custom-ran :to-be 'lambda)
            (expect prompt-calls :to-be 0)
            ;; 5. Uncovered named function
            (cl-letf (((symbol-function 'dp-test--custom-display-fn)
                       (lambda (b _a)
                         (setq custom-ran 'symbol)
                         (set-window-buffer w2 b)
                         w2)))
              (expect (display-buffer buf '((dp-test--custom-display-fn)))
                      :to-be w2)
              (expect custom-ran :to-be 'symbol)
              (expect prompt-calls :to-be 0)))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf))))

  (it "handles display-buffer-no-window with and without allow-no-window"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-nowin*"))
           (other (get-buffer-create "*m3-nowin-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; With allow-no-window: returns fail -> display-buffer returns nil, no prompt
            (let ((prompt-calls 0)
                  (later-ran nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) (setq prompt-calls (1+ prompt-calls)) nil))
                        ((symbol-function 'display-buffer-below-selected)
                         (lambda (_b _a) (setq later-ran t) w2)))
                (expect (display-buffer
                         buf '((display-buffer-no-window
                                display-buffer-below-selected)
                               (allow-no-window . t)))
                        :to-be nil)
                (expect prompt-calls :to-be 0)
                (expect later-ran :to-be nil)))
            ;; Without allow-no-window + fallback function: continues to next caller function
            (let ((seen-header nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-header (plist-get opts :header-info))
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer
                         buf '((display-buffer-no-window
                                display-buffer-below-selected)))
                        :to-be w2)
                (expect (plist-get seen-header :caller-intent)
                        :to-equal
                        "Caller: no window; else below the selected window")))
            ;; Without allow-no-window and no fallback: continues to no-preference (dp-action--run)
            (set-window-buffer w2 other)
            (select-window w1)
            (expect (display-buffer buf '((display-buffer-no-window))) :to-be w1))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "classifies reuse-first chains (other-frame, side fallback, below fallback, and standalone miss)"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-chain*"))
           (other (get-buffer-create "*m3-chain-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. C-x 5 b (display-buffer--other-frame-action):
            ;;    when visible in w2, reuse=auto reuses silently; frame prompt does NOT run
            (set-window-buffer w2 buf)
            (select-window w1)
            (let ((dp-reuse 'auto)
                  (frame-calls 0)
                  (prompt-calls 0))
              (cl-letf (((symbol-function 'dp-action--frame)
                         (lambda (&rest _) (setq frame-calls (1+ frame-calls)) w1))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) (setq prompt-calls (1+ prompt-calls)) nil)))
                (expect (display-buffer buf display-buffer--other-frame-action)
                        :to-be w2)
                (expect frame-calls :to-be 0)
                (expect prompt-calls :to-be 0)))
            ;;    when visible in w2 and reuse=ask: dispatch prompt with full chain header & w2 default
            (let ((dp-reuse 'ask)
                  (seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf display-buffer--other-frame-action)
                        :to-be w1)
                (expect (plist-get seen-opts :default) :to-equal (list :window w2))
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: reuse; else new frame")
                (expect (car (plist-get (plist-get seen-opts :header-info) :window-facts))
                        :to-match "\\[2\\]")))
            ;;    when NOT visible anywhere: falls through to frame prompt
            (set-window-buffer w1 other)
            (set-window-buffer w2 other)
            (let ((frame-calls 0))
              (cl-letf (((symbol-function 'dp-action--frame)
                         (lambda (&rest _) (setq frame-calls (1+ frame-calls)) w2)))
                (expect (display-buffer buf display-buffer--other-frame-action)
                        :to-be w2)
                (expect frame-calls :to-be 1)))

            ;; 2. (display-buffer-reuse-window display-buffer-in-side-window):
            ;;    miss -> Respects side window without prompting
            (let ((prompt-calls 0))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) (setq prompt-calls (1+ prompt-calls)) nil)))
                (let ((side (display-buffer
                             buf '((display-buffer-reuse-window
                                    display-buffer-in-side-window)
                                   (side . right)))))
                  (expect (window-parameter side 'window-side) :to-be 'right)
                  (expect prompt-calls :to-be 0)
                  (when (window-live-p side) (delete-window side)))))
            ;;    hit with reuse=ask -> prompts with "Caller: reuse; else side window"
            (set-window-buffer w2 buf)
            (let ((dp-reuse 'ask)
                  (seen-header nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-header (plist-get opts :header-info))
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer
                         buf '((display-buffer-reuse-window
                                display-buffer-in-side-window)
                               (side . right)))
                        :to-be w2)
                (expect (plist-get seen-header :caller-intent)
                        :to-equal "Caller: reuse; else side window")))

            ;; 3. (display-buffer-reuse-window display-buffer-below-selected) on miss:
            ;;    preserves primary phrase "reuse" without duplicating fallback phrase
            (set-window-buffer w2 other)
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer
                         buf '((display-buffer-reuse-window
                                display-buffer-below-selected)))
                        :to-be w2)
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: reuse; else below the selected window")
                (expect (plist-get seen-opts :default)
                        :to-equal '(:action caller-intent))))

            ;; 4. Standalone display-buffer-reuse-window miss: no default + window fact
            (set-window-buffer w2 other)
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf '((display-buffer-reuse-window)))
                        :to-be w2)
                (expect (plist-get seen-opts :default) :to-be nil)
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: reuse")
                (expect (plist-get (plist-get seen-opts :header-info) :window-facts)
                        :to-equal '("no window displays the buffer")))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "offers 'Reuse in frame NAME' when reuse=ask matches a window on another frame and honors inhibit-switch-frame"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (f1 (selected-frame))
           (f2 'fake-other-frame)
           (w1 (selected-window))
           (w-other (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-cross-frame*"))
           (other (get-buffer-create "*m3-cross-other*"))
           (orig-wf (symbol-function 'window-frame))
           (orig-fp (symbol-function 'frame-parameter)))
      (set-window-buffer w1 other)
      (set-window-buffer w-other buf)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (let ((dp-reuse 'ask)
                (seen-opts nil)
                (raised nil))
            ;; Choosing M-c (Reuse in frame OtherFrame) reuses w-other and raises f2
            (cl-letf (((symbol-function 'window-frame)
                       (lambda (&optional win)
                         (if (eq win w-other) f2 (funcall orig-wf win))))
                      ((symbol-function 'frame-parameter)
                       (lambda (frame param)
                         (if (eq frame f2)
                             (and (eq param 'name) "OtherFrame")
                           (funcall orig-fp frame param))))
                      ((symbol-function 'dp-window-utility--scope-windows)
                       (lambda (&optional _) (list w1)))
                      ((symbol-function 'dp-window-utility-dispatch-prompt)
                       (lambda (_b a &rest opts)
                         (setq seen-opts opts)
                         (list :action 'reuse-other-frame :alist a)))
                      ((symbol-function 'window--maybe-raise-frame)
                       (lambda (fr) (push fr raised))))
              (expect (display-buffer
                       buf '((display-buffer-reuse-window)
                             (reusable-frames . t)))
                      :to-be w-other)
              (expect (plist-get seen-opts :caller-action)
                      :to-equal '(:label "Reuse in frame OtherFrame"
                                  :action reuse-other-frame))
              (expect (plist-get seen-opts :default)
                      :to-equal '(:action reuse-other-frame))
              (expect (plist-get (plist-get seen-opts :header-info) :window-facts)
                      :to-equal '("window in frame OtherFrame displays the buffer"))
              (expect (memq f2 raised) :to-be-truthy))
            ;; With (inhibit-switch-frame . t), frame is NOT raised
            (setq raised nil)
            (cl-letf (((symbol-function 'window-frame)
                       (lambda (&optional win)
                         (if (eq win w-other) f2 (funcall orig-wf win))))
                      ((symbol-function 'frame-parameter)
                       (lambda (frame param)
                         (if (eq frame f2)
                             (and (eq param 'name) "OtherFrame")
                           (funcall orig-fp frame param))))
                      ((symbol-function 'dp-window-utility--scope-windows)
                       (lambda (&optional _) (list w1)))
                      ((symbol-function 'dp-window-utility-dispatch-prompt)
                       (lambda (_b a &rest _)
                         (list :action 'reuse-other-frame :alist a)))
                      ((symbol-function 'window--maybe-raise-frame)
                       (lambda (fr) (push fr raised))))
              (expect (display-buffer
                       buf '((display-buffer-reuse-window)
                             (reusable-frames . t)
                             (inhibit-switch-frame . t)))
                      :to-be w-other)
              (expect raised :to-be nil)))
        (dp-action-mode -1)
        (when (window-live-p w-other) (delete-window w-other))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "implements display-buffer-reuse-mode-window mode default and 4-tier priority"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (f2 'fake-mode-frame)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (w-f2 (split-window w2 nil 'right))
           (buf-base-1 (get-buffer-create "*m3-base-1*"))
           (buf-base-2 (get-buffer-create "*m3-base-2*"))
           (buf-child (get-buffer-create "*m3-child*"))
           (buf-target (get-buffer-create "*m3-target*"))
           (buf-plain (get-buffer-create "*m3-plain*"))
           (orig-wf (symbol-function 'window-frame)))
      (with-current-buffer buf-base-1 (dp-test-base-mode))
      (with-current-buffer buf-base-2 (dp-test-base-mode))
      (with-current-buffer buf-child (dp-test-child-mode))
      (with-current-buffer buf-target (dp-test-base-mode))
      (dp-action-mode +1)
      (unwind-protect
          (let ((dp-reuse 'auto))
            (cl-letf (((symbol-function 'window-frame)
                       (lambda (&optional win)
                         (if (eq win w-f2) f2 (funcall orig-wf win))))
                      ((symbol-function 'window-list-1)
                       (lambda (&rest _) (list w1 w2 w-f2)))
                      ((symbol-function 'window--maybe-raise-frame) #'ignore))
              ;; Tier check: same-mode other-frame beats derived-mode same-frame!
              (set-window-buffer w1 buf-plain)
              (set-window-buffer w2 buf-child)    ; derived-same
              (set-window-buffer w-f2 buf-base-1) ; same-other
              (select-window w1)
              ;; Omitted `mode' defaults to buf-target's major-mode (`dp-test-base-mode')
              (expect (display-buffer
                       buf-target '((display-buffer-reuse-mode-window)
                                    (reusable-frames . t)))
                      :to-be w-f2)
              ;; Now place same-mode on same frame -> beats same-mode other-frame
              (set-window-buffer w-f2 buf-base-1)
              (set-window-buffer w2 buf-base-2)
              (expect (display-buffer
                       buf-target '((display-buffer-reuse-mode-window)
                                    (reusable-frames . t)))
                      :to-be w2)
              ;; Explicit mode list works and skips dedicated-to-other windows
              (set-window-buffer w2 buf-child)
              (set-window-dedicated-p w2 t)
              (set-window-buffer w-f2 buf-base-1)
              (expect (display-buffer
                       buf-target '((display-buffer-reuse-mode-window)
                                    (mode . (dp-test-child-mode dp-test-base-mode))
                                    (reusable-frames . t)))
                      :to-be w-f2)))
        (dp-action-mode -1)
        (when (window-live-p w-f2) (delete-window w-f2))
        (when (window-live-p w2)
          (set-window-dedicated-p w2 nil)
          (delete-window w2))
        (dolist (b (list buf-base-1 buf-base-2 buf-child buf-target buf-plain))
          (kill-buffer b)))))

  (it "honors reuse-indirect (t, buffer no-swap, and nil) under auto and ask"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (base (get-buffer-create "*m3-ind-base*"))
           (ind (make-indirect-buffer base "*m3-ind-clone*"))
           (other (get-buffer-create "*m3-ind-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 base)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; (reuse-indirect . nil) does NOT match base window for indirect buffer
            (let ((dp-reuse 'auto))
              (expect (dp-action--find-reuse-windows ind '((reuse-indirect . nil)))
                      :to-be nil))
            ;; (reuse-indirect . buffer) with reuse=auto returns w2 WITHOUT replacing base!
            (let ((dp-reuse 'auto))
              (expect (display-buffer ind '((display-buffer-reuse-window)
                                            (reuse-indirect . buffer)))
                      :to-be w2)
              (expect (window-buffer w2) :to-be base))
            ;; (reuse-indirect . buffer) with reuse=ask: picking w2 keeps base, picking w1 swaps to ind
            (let ((dp-reuse 'ask))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer ind '((display-buffer-reuse-window)
                                              (reuse-indirect . buffer)))
                        :to-be w2)
                (expect (window-buffer w2) :to-be base))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer ind '((display-buffer-reuse-window)
                                              (reuse-indirect . buffer)))
                        :to-be w1)
                (expect (window-buffer w1) :to-be ind)))
            ;; (reuse-indirect . t) switches w2 to ind
            (set-window-buffer w1 other)
            (set-window-buffer w2 base)
            (let ((dp-reuse 'auto))
              (expect (display-buffer ind '((display-buffer-reuse-window)
                                            (reuse-indirect . t)))
                      :to-be w2)
              (expect (window-buffer w2) :to-be ind)))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer ind)
        (kill-buffer base)
        (kill-buffer other))))

  (it "handles non-list ACTION, empty-function inhibit-same-window, dynamic pop-up-frames, and display-buffer-reuse-frames"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-other*"))
           (other (get-buffer-create "*m3-other-2*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. ACTION t ('other-window too): selected window remains eligible & choosing it
            ;;    binds inhibit-same-window to nil; default is caller-intent when not visible
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf t) :to-be w1)
                (expect (window-buffer w1) :to-be buf)
                (expect (plist-get seen-opts :default) :to-equal '(:action caller-intent))
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: other window")))
            ;;    when visible in w2, default is w2
            (set-window-buffer w1 other)
            (set-window-buffer w2 buf)
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf 'other-window) :to-be w2)
                (expect (plist-get seen-opts :default) :to-equal (list :window w2))))
            ;; 2. Dynamic pop-up-frames routes empty-function calls to frame prompt
            (set-window-buffer w2 other)
            (let ((pop-up-frames t)
                  (frame-calls 0))
              (cl-letf (((symbol-function 'dp-action--frame)
                         (lambda (&rest _) (setq frame-calls (1+ frame-calls)) w2)))
                (expect (display-buffer buf t) :to-be w2)
                (expect frame-calls :to-be 1))
              ;; Alist (pop-up-frames . nil) overrides dynamic pop-up-frames
              (setq frame-calls 0)
              (cl-letf (((symbol-function 'dp-action--frame)
                         (lambda (&rest _) (setq frame-calls (1+ frame-calls)) w2)))
                (expect (display-buffer buf '(nil (pop-up-frames . nil))) :to-be w1)
                (expect frame-calls :to-be 0)))
            ;; 3. Dynamic display-buffer-reuse-frames resolves reusable-frames to 0
            ;;    and passes 0 to get-buffer-window-list during no-preference reuse
            (set-window-buffer w1 other)
            (set-window-buffer w2 buf)
            (let ((display-buffer-reuse-frames t)
                  (dp-reuse 'auto)
                  (seen-frames 'unset)
                  (orig-gbwl (symbol-function 'get-buffer-window-list)))
              (cl-letf (((symbol-function 'get-buffer-window-list)
                         (lambda (b mini frames &optional ind)
                           (setq seen-frames frames)
                           (funcall orig-gbwl b mini frames ind))))
                (expect (display-buffer buf) :to-be w2)
                (expect seen-frames :to-be 0))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other)))))

(describe "disbuf-pivot same-window, previous-window, full-frame, and relative intents"
  (it "handles same-window displayable, dedicated-to-self, side window, and inhibit-same-window conflict"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-same*"))
           (other (get-buffer-create "*m3-same-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 other)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. Clean same-window displays silently in w1
            (let ((prompt-calls 0))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) (setq prompt-calls (1+ prompt-calls)) nil)))
                (expect (display-buffer buf '((display-buffer-same-window))) :to-be w1)
                (expect prompt-calls :to-be 0)))
            ;; 2. Dedicated to THIS buffer is still displayable (Emacs would have rejected it)
            (set-window-dedicated-p w1 t)
            (expect (display-buffer buf '((display-buffer-same-window))) :to-be w1)
            ;; 3. Dedicated to ANOTHER buffer -> prompts with window fact
            (set-window-dedicated-p w1 nil)
            (set-window-buffer w1 other)
            (set-window-dedicated-p w1 t)
            (let ((seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w2 :alist a))))
                (expect (display-buffer buf '((display-buffer-same-window))) :to-be w2)
                (expect (plist-get seen-opts :default) :to-be nil)
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: same window")
                (expect (plist-get (plist-get seen-opts :header-info) :window-facts)
                        :to-equal '("selected window cannot display"))))
            (set-window-dedicated-p w1 nil)
            ;; 4. Side window selected -> undisplayable, prompts!
            (let ((side (display-buffer-in-side-window
                         other '((side . right)))))
              (select-window side)
              (let ((seen-opts nil))
                (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                           (lambda (_b a &rest opts)
                             (setq seen-opts opts)
                             (list :action 'window :window w2 :alist a))))
                  (expect (display-buffer buf '((display-buffer-same-window))) :to-be w2)
                  (expect (plist-get (plist-get seen-opts :header-info) :window-facts)
                          :to-equal '("selected window cannot display"))))
              (select-window w1)
              (when (window-live-p side) (delete-window side)))
            ;; 5. Conflict from base-action + dp-same-window-conflict = 'ask
            (let ((display-buffer-base-action '(nil (inhibit-same-window . t)))
                  (dp-same-window-conflict 'ask)
                  (seen-opts nil)
                  (msgs nil))
              (cl-letf (((symbol-function 'message)
                         (lambda (fmt &rest args) (push (apply #'format fmt args) msgs)))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf '((display-buffer-same-window))) :to-be w1)
                (expect (window-buffer w1) :to-be buf)
                (expect (cl-some (lambda (m) (string-match-p "same-window conflict.*base action" m)) msgs)
                        :to-be-truthy)
                (expect (plist-get seen-opts :default) :to-equal (list :window w1))
                (expect (plist-get (plist-get seen-opts :header-info) :source-entries)
                        :to-equal '("base action: inhibit same window"))))
            ;; 6. Conflict from base-action + dp-same-window-conflict = 'same-window
            (set-window-buffer w1 other)
            (let ((display-buffer-base-action '(nil (inhibit-same-window . t)))
                  (dp-same-window-conflict 'same-window)
                  (prompt-calls 0)
                  (msgs nil))
              (cl-letf (((symbol-function 'message)
                         (lambda (fmt &rest args) (push (apply #'format fmt args) msgs)))
                        ((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) (setq prompt-calls (1+ prompt-calls)) nil)))
                (expect (display-buffer buf '((display-buffer-same-window))) :to-be w1)
                (expect prompt-calls :to-be 0)
                (expect (cl-some (lambda (m) (string-match-p "same-window conflict" m)) msgs)
                        :to-be-truthy)))
            ;; 7. Self-contradictory caller same-window + inhibit-same-window
            (set-window-buffer w1 other)
            (let ((dp-same-window-conflict 'ask)
                  (seen-opts nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest opts)
                           (setq seen-opts opts)
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf '((display-buffer-same-window)
                                              (inhibit-same-window . t)))
                        :to-be w1)
                (expect (plist-get (plist-get seen-opts :header-info) :caller-intent)
                        :to-equal "Caller: same window, inhibit same window")
                (expect (plist-get (plist-get seen-opts :header-info) :source-entries)
                        :to-be nil))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

