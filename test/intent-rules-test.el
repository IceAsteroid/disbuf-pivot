(describe "disbuf-pivot regulated dp-action--run and TYPE propagation"
  (it "honors disbuf-pivot-reuse, bypass stop, and per-buffer displayable in dp-action--run regardless of order"
    (delete-other-windows)
    (let* ((noninteractive nil)
           (w1 (selected-window))
           (w2 (split-window w1 nil 'below))
           (buf (get-buffer-create "*m3-run*"))
           (other (get-buffer-create "*m3-run-other*")))
      (set-window-buffer w1 other)
      (set-window-buffer w2 buf)
      (select-window w1)
      (dp-action-mode +1)
      (unwind-protect
          (progn
            ;; 1. dp-reuse = 'ask prompts even in no-preference dp-action--run
            (let ((dp-reuse 'ask)
                  (prompt-calls 0))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (_b a &rest _)
                           (setq prompt-calls (1+ prompt-calls))
                           (list :action 'window :window w1 :alist a))))
                (expect (display-buffer buf) :to-be w1)
                (expect prompt-calls :to-be 1)))
            ;; 2. Pressing M-b (bypass) inside dp-reuse='ask stops dp-action--run immediately
            ;;    (must NOT fall through to display-buffer-same-window in dp-action-functions!)
            (set-window-buffer w1 other)
            (set-window-buffer w2 buf)
            (let ((dp-reuse 'ask)
                  (same-ran nil))
              (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                         (lambda (&rest _) '(:action bypass)))
                        ((symbol-function 'dp-action--regulated-same-window)
                         (lambda (&rest _) (setq same-ran t) w1)))
                ;; Bypass returns nil to display-buffer -> fallback reuses w2
                (expect (display-buffer buf) :to-be w2)
                (expect same-ran :to-be nil)))
            ;; 3. Reordered dp-action-functions with same-window first:
            ;;    accepts dedicated-to-self and rejects side window
            (let ((dp-action-functions '(display-buffer-same-window
                                         display-buffer-reuse-window
                                         dp-action-choose-window)))
              (set-window-buffer w1 buf)
              (set-window-dedicated-p w1 t)
              (expect (display-buffer buf) :to-be w1)
              (set-window-dedicated-p w1 nil)
              (let ((side (display-buffer-in-side-window other '((side . right)))))
                (select-window side)
                (set-window-buffer w2 other)
                (set-window-buffer w1 other)
                (let ((prompt-calls 0))
                  (cl-letf (((symbol-function 'dp-window-utility-dispatch-prompt)
                             (lambda (_b a &rest _)
                               (setq prompt-calls (1+ prompt-calls))
                               (list :action 'window :window w2 :alist a))))
                    (expect (display-buffer buf) :to-be w2)
                    (expect prompt-calls :to-be 1)))
                (select-window w1)
                (when (window-live-p side) (delete-window side)))))
        (dp-action-mode -1)
        (when (window-live-p w2) (delete-window w2))
        (kill-buffer buf)
        (kill-buffer other))))

  (it "propagates exact window--display-buffer TYPE for reuse, window (split), tab, and frame"
    (delete-other-windows)
    (let* ((noninteractive nil)
